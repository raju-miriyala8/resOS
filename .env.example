# Use a long, unique value for JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-secret

# Leave this unset to use the MongoDB container from docker-compose.yml.
# For MongoDB Atlas, replace it with your Atlas connection string.
# MONGODB_URL=mongodb+srv://...

# Optional: change the host port serving the app (default 8080).
# RESOS_PORT=8080
